################################################################
# Manage riprap deployments through Crypto Infrastructure as Code
################################################################

addon "svm" {
    rpc_api_url = input.rpc_api_url
    network_id = input.network_id
}

action "deploy_pool" "svm::deploy_program" {
    description = "Deploy pool program"
    program = svm::get_program_from_anchor_project("pool")
    authority = signer.authority
    payer = signer.payer
    # Instant cheatcode deploy: writes program data directly to the program
    # account on a local Surfnet (port of the accord runbook pairing —
    # `anchor test` starts Surfpool, which runs this manifest and has the
    # workspace programs live before the [scripts] jest runner fires).
    # Gated to localnet: a real mainnet/devnet deploy must go through the
    # real buffer→upgrade path, never the cheatcode (security review
    # 2026-09-18).
    instant_surfnet_deployment = input.network_id == "localnet"
}

action "deploy_hanse" "svm::deploy_program" {
    description = "Deploy hanse program"
    program = svm::get_program_from_anchor_project("hanse")
    authority = signer.authority
    payer = signer.payer
    instant_surfnet_deployment = input.network_id == "localnet"
}

action "deploy_sas" "svm::deploy_program" {
    description = "Deploy the SAS binary (closed circle, §2.8) at its keypair address"
    # SAS is a localnet-only fixture (the jest harness clones it to the
    # canonical 22zoJ… id via surfnet_cloneProgramAccount); it never deploys
    # to devnet or mainnet — the canonical program already lives there.
    when = input.network_id == "localnet"
    # Staged from ../solana-attestation-service into target/deploy by
    # tests/deps/stage.sh. The canonical 22zoJ… keypair is not ours, so the
    # binary deploys at the sibling keypair's address; the jest harness
    # clones it to the canonical id via surfnet_cloneProgramAccount (see
    # tests/src/setup/deploy.ts ensureSasProgram — raw setAccount
    # fabrications do not execute on Surfpool).
    program = svm::get_program_from_native_project("solana_attestation_service")
    authority = signer.authority
    payer = signer.payer
    instant_surfnet_deployment = input.network_id == "localnet"
}
