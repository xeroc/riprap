{
  "name": "@riprap/pool",
  "private": true,
  "version": "0.5.0",
  "description": "Generated Codama client for the Riprap pool program — deposited money with exactly two governed exits: spending and liquidation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeroc/riprap.git",
    "directory": "packages/pool"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "riprap": "codama",
    "codegen": "codama run js && biome check --write generated",
    "build": "tsup && tsc -p tsconfig.build.json",
    "lint": "biome check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "@solana/program-client-core": "^7.1.1"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.5",
    "@codama/renderers-js": "^2.4.0",
    "@types/node": "^24.13.3",
    "codama": "latest",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
