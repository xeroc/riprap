# Riprap Cranker environment (copy to .env) — RIPRAP_* names, localnet defaults.

# Solana JSON-RPC endpoint (default: http://127.0.0.1:8899)
RIPRAP_RPC_URL=http://127.0.0.1:8899

# WebSocket endpoint for send+confirm (default: ws counterpart of RIPRAP_RPC_URL)
#RIPRAP_WS_URL=ws://127.0.0.1:8900

# REQUIRED: the cranker's fee-payer keypair (solana keypair JSON path).
# For the pilot this must be the mutual's authority (Breakpoint pass gate on
# claim_payout — ADR-0005); every other crank is fully permissionless.
RIPRAP_CRANKER_KEYPAIR=~/.config/solana/id.json

# Poll interval in ms (default: 60000 — lifecycle gates tick in hours/days)
#RIPRAP_CRANKER_INTERVAL_MS=60000

# Optional: restrict discovery to specific mutuals (comma-separated).
# Default: every Mutual account on the hanse program.
#RIPRAP_CRANKER_MUTUALS=
