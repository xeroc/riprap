// n8n webhook URL the waitlist form POSTs { email, type, timestamp } to.
// Same contract as chainsquad.com / accord (VITE_N8N_WEBHOOK_URL).
// Copy to .env and set. Exposed to the client (Vite VITE_ prefix), so it is not a secret.
VITE_N8N_WEBHOOK_URL=

// Solana entry config — consumed ONLY by the pool (/2026-breakpoint-blade-pool/)
// and /app/ entries (ConnectorKit cluster setup); the platform entry (/) reads
// none of these. All optional; unset falls back to the public cluster defaults.
// Custom RPC endpoints for the devnet / mainnet-beta clusters.
VITE_DEVNET_RPC=
VITE_MAINNET_RPC=
// Mutual account address for Surfpool/localnet development (the per-cluster
// address map in the pool page covers devnet + mainnet-beta).
VITE_LOCALNET_MUTUAL=
