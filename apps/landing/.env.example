# apps/landing — all optional. The platform route (/) consumes NONE of these;
# only the pool (#/2026-breakpoint-blade-pool), app (#/app), and create
# (#/create) routes read them.
# Copy to .env.local for dev; CI builds run on the public defaults.

# Custom RPC endpoints for the ConnectorKit cluster list (public defaults
# when unset). Mainnet is the default cluster.
#VITE_DEVNET_RPC=https://api.devnet.solana.com
#VITE_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Mutual account address for Surfpool/localnet development (pool page).
#VITE_LOCALNET_POOL=

# #/create's default contribution/fee mint per cluster: mainnet USDC on
# mainnet, devnet USDC on devnet; localnet shares the devnet mint unless
# pinned (a surfnet mint is arbitrary — pin your test mint).
#VITE_DEPOSIT_MINT_LOCALNET=

# Waitlist-form webhook (every route).
#VITE_N8N_WEBHOOK_URL=

# Accord evidence daemon — one base URL per cluster (anchored cover terms on
# the pool page). Localnet shares the resolved devnet value unless pinned.
#VITE_EVIDENCE_DAEMON_URL_DEVNET=https://api.devnet.useaccord.xyz
#VITE_EVIDENCE_DAEMON_URL_MAINNET=https://api.useaccord.xyz
#VITE_EVIDENCE_DAEMON_URL_LOCALNET=

# Evidence operator pubkey per cluster — the #/create wizard deploys with
# this operator; unset (default) means the creator's wallet (EVENT-MUTUAL §7
# v1 — a Riprap-operated default arrives with the daemon's published key).
#VITE_EVIDENCE_OPERATOR_DEVNET=
#VITE_EVIDENCE_OPERATOR_MAINNET=
#VITE_EVIDENCE_OPERATOR_LOCALNET=
