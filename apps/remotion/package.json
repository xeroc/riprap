{
  "name": "@riprap/remotion",
  "version": "0.1.0",
  "private": true,
  "description": "@riprap/remotion — Remotion 4 video compositions rendering @riprap/ui kit illustrations under the glyph clock (deterministic settle motion). Audio artifacts and render output are local-only.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && remotion bundle",
    "lint": "biome check src",
    "studio": "tsx src/cli/score.ts --stale && remotion studio",
    "render": "tsx src/cli/score.ts --stale && remotion render",
    "score": "tsx src/cli/score.ts",
    "clean": "rm -rf build out public/audio"
  },
  "dependencies": {
    "@remotion/cli": "4.0.514",
    "@riprap/ui": "workspace:*",
    "@strudel/web": "1.3.0",
    "node-web-audio-api": "^2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.514"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2"
  }
}
