// breakpoint-intro-24s — "passive pulse" (Strudel score), riprap family
//
// Prebaked to public/audio/breakpoint-intro-24s.wav (gitignored artifact):
//   pnpm --filter @riprap/remotion score breakpoint-intro-24s 24
// Pasteable into https://strudel.cc as-is.
//
// 120 BPM grid: cpm 30 → 1 bar = 2.000s = 60 frames @30fps.
// Family: riprap — Gb major, loop Gbmaj9 · Ebm9 · Dbmaj9 (MUSIC.md).
// Relaxing by design: soft-heel 909 pulse, hushed piano arps, one chord
// per bar — the bed loses every attention contest to the on-screen text.
// Scene map: aurora b1–3 (flip ~4s) · counter b4–6 (count lands ~8.5s)
// · converge b7–10 (phrase locks ~13.9s) · endcard b11–12.
// Markers (3 of 12 bars — ≥70% marker-free, marker law): count-landing
// tick b5 · converge rise b7 · endcard bloom+button b11.
setcpm(30)

// ── bed ──
const kick = s("bd ~ bd ~").bank("RolandTR909").gain(.45) // pulse on 1 & 3
const tick = s("~ hh ~ hh").gain(.09).hpf(9000)           // whisper hats
const rimt = s("~ ~ rim ~").gain(.13)                     // one wooden tick per bar
const arpGb = note("gb3 [bb3 db4] [f4 ab4] ~").s("piano").gain(.34).room(.35)
const arpEb = note("eb3 [gb3 bb3] [db4 eb4] ~").s("piano").gain(.32).room(.35)
const arpDb = note("db3 [f3 ab3] [c4 eb4] ~").s("piano").gain(.32).room(.35)
const pad = x => note(x).s("triangle").fm("<0 2 4>").clip(1).attack(.8).release(1.2).gain(.22).room(.4)
const hum = x => note(x).s("piano").gain(.2).room(.4)     // sparse top-line hum

// ── aurora b1–3 · 0–6s — the blob rises, the flip lands late b2 ──
const b1 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.45), pad("gb2"))
const b2 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.42), tick, pad("gb2"))
const b3 = stack(kick, arpGb, tick, pad("gb2"))

// ── counter b4–6 · 6–12s — arps enter; tick when the count lands (~8.5s) ──
const b4 = stack(kick, arpEb, tick, rimt, pad("eb2"), hum("db5"))
const b5 = stack(kick, arpDb, tick, s("rim ~ rim ~").gain(.16), pad("db2")) // marker — count lands
const b6 = stack(kick, arpGb, tick, rimt, pad("gb2"))

// ── converge b7–10 · 12–20s — rise when the phrase locks (~13.9s), then thin ──
const b7 = stack(kick, arpEb, tick, rimt, pad("eb2"),
  note("[~ bb5] ~ ~ ~").s("piano").gain(.16).room(.5))    // marker — rise, phrase locks
const b8 = stack(kick, arpDb, tick, pad("db2"))
const b9 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.4), arpGb.release(1.5), pad("gb2"))
const b10 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.4), arpEb.release(1.5), pad("eb2"))

// ── endcard b11–12 · 20–24s — home: bloom on the mark, button on the link ──
const b11 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.42), arpGb, tick, pad("gb2"),
  note("~ ~ ~ ~ ~ ~ ~ [gb4,bb4,db5,f5,ab5]").s("piano").gain(.3).room(.5).release(1.5), // bloom — the mark settles @20.4
  note("~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [gb4,gb5] ~").s("piano").gain(.24).room(.45).release(.5))   // button — riprap.xyz @21.0
const b12 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.4),
  note("[gb3,bb3,db4,ab4]").s("piano").sustain(.2).release(.8).gain(.3).room(.5)) // Gbmaj9 shell — decays, silent before 24
cat(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  .gain(.40)
